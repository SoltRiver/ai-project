&lt;td style="border-left: 0px none ; border-top: 2px solid #000000; border-right: 0px none ; border-bottom: 1px solid #000000; width: 130.06666666666666666666666667px; vertical-align: middle; padding-bottom: 0px; padding-top: 0px; padding-left: 0px; padding-right: 0px"&gt;
&lt;p style="margin-left: 6px; margin-right: 6px; text-align: right"&gt;2025年８月&lt;/p&gt;
