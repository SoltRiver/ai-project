# ============================================================
# 株価分析アプリ - 環境変数テンプレート
# このファイルを .env にコピーして、各値を設定してください。
# cp .env.example .env
# ============================================================

# === LLMプロバイダ ===
OPENAI_API_KEY=
GOOGLE_API_KEY=

# === EDINET ===
EDINET_API_KEY=

# === J-Quants ===
JQUANTS_API_KEY=

# === LangSmith トレース設定 ===
# true に設定するとLangSmithへのトレース記録が有効になる
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
# プロジェクト名（環境ごとに分ける）
# 例:
#   stock-analysis-dev        - 開発環境
#   stock-analysis-prod       - 本番環境
#   stock-analysis-rag        - RAG専用
#   stock-analysis-agent      - エージェント専用
#   stock-analysis-evaluation  - 評価実行用
LANGCHAIN_PROJECT=stock-analysis-dev
